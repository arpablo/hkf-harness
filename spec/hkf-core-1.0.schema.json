{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpablo/hkf-spec/schema/hkf-core-1.0.schema.json",
  "title": "HKF Core 1.0 — Frontmatter",
  "description": "Normativ fuer das Frontmatter einer Notiz und der beiden Wurzeldateien. Einstiegspunkte: #/$defs/notiz, #/$defs/hkb, #/$defs/hbundle. Die Werte werden als YAML gelesen; Datum und Zeitpunkt sind vor der Pruefung in ihre ISO-Schreibweise zu bringen. Bei Abweichung zu HKF-Core-V1.0.md gilt die Spezifikation.",
  "$ref": "#/$defs/notiz",
  "$defs": {
    "property-name": {
      "description": "3.4 — Property-Namen sind snake_case.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "skalar": {
      "description": "3.4 — Text, Zahl oder Checkbox. Kein null, kein leerer Text.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "flache-liste": {
      "description": "3.4 — Liste von Skalaren. Eine leere Liste wird nicht geschrieben.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skalar"
      }
    },
    "wert": {
      "description": "3.4 — Verschachtelte Abbildungen und Listen von Abbildungen sind unzulaessig.",
      "oneOf": [
        {
          "$ref": "#/$defs/skalar"
        },
        {
          "$ref": "#/$defs/flache-liste"
        }
      ]
    },
    "kebab": {
      "description": "Anhang B.1",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "description": "3.4 — ohne Versatz; modified und imported sind UTC.",
      "type": "string",
      "pattern": "^-?[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$"
    },
    "wikilink": {
      "description": "Anhang B.2",
      "type": "string",
      "pattern": "^\\[\\[[^\\u0000-\\u001f/\\]|]+(/[^\\u0000-\\u001f/\\]|]+)*(\\|[^\\u0000-\\u001f\\]|]+)?\\]\\]$"
    },
    "hkf-url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "hkf-email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "hkf-phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{6,14}$"
    },
    "hkf-lang": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "hkf-country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "hkf-latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "hkf-longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "hkf-year": {
      "type": "number",
      "minimum": -4000,
      "maximum": 9999
    },
    "hkf-wikidata": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "hkf-file": {
      "description": "3.5.1 — Wikilink auf eine Mediendatei, mit Dateiendung, nicht .md.",
      "allOf": [
        {
          "$ref": "#/$defs/wikilink"
        },
        {
          "type": "string",
          "pattern": "\\.[A-Za-z0-9]+(\\|[^\\]]*)?\\]\\]$"
        },
        {
          "not": {
            "type": "string",
            "pattern": "\\.md(\\|[^\\]]*)?\\]\\]$"
          }
        }
      ]
    },
    "hkf-link": {
      "$ref": "#/$defs/wikilink"
    },
    "hkf-link-list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/wikilink"
      }
    },
    "standard-proptypes": {
      "description": "3.5.1 — die vierzehn Standard-Property-Typen, aufgezählt in HKF Config §2.1. Nicht dazu gehören die drei Aufzählungen aus Config §2.2: Sie sind Vokabular, und ein Bundle darf sie mitliefern.",
      "enum": [
        "hkf-country",
        "hkf-email",
        "hkf-file",
        "hkf-lang",
        "hkf-latitude",
        "hkf-link",
        "hkf-link-list",
        "hkf-link-or-text",
        "hkf-link-or-url",
        "hkf-longitude",
        "hkf-phone",
        "hkf-url",
        "hkf-wikidata",
        "hkf-year"
      ]
    },
    "hkf-link-or-text": {
      "description": "Config §2.1 — ein qualifizierter Wikilink oder ein beliebiger Text; beides ist Text.",
      "type": "string",
      "minLength": 1
    },
    "hkf-link-or-url": {
      "oneOf": [
        {
          "$ref": "#/$defs/wikilink"
        },
        {
          "$ref": "#/$defs/hkf-url"
        }
      ]
    },
    "hkf-link-or-url-list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hkf-link-or-url"
      }
    },
    "notiz": {
      "description": "3.3 — Pflicht ist genau eine Property: type.",
      "type": "object",
      "required": [
        "type"
      ],
      "propertyNames": {
        "$ref": "#/$defs/property-name"
      },
      "properties": {
        "aliases": {
          "$ref": "#/$defs/flache-liste"
        },
        "bundles": {
          "$ref": "#/$defs/hkf-link-list"
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "cssclasses": {
          "$ref": "#/$defs/flache-liste"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "type": "string",
          "pattern": "^[^/][^\\u0000-\\u001f]*[^/]$|^[^/\\u0000-\\u001f]$"
        },
        "extends": {
          "type": "string",
          "minLength": 1
        },
        "form": {
          "enum": [
            "text",
            "list",
            "number",
            "checkbox",
            "date",
            "datetime"
          ]
        },
        "modified": {
          "$ref": "#/$defs/datetime"
        },
        "modified_by": {
          "type": "string",
          "minLength": 1
        },
        "provisional": {
          "const": true
        },
        "rejected_links": {
          "$ref": "#/$defs/hkf-link-list"
        },
        "related": {
          "$ref": "#/$defs/hkf-link-or-url-list"
        },
        "sources": {
          "$ref": "#/$defs/hkf-link-list"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "$ref": "#/$defs/flache-liste"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "3.3 — der Typname als Text, oder in einer HKB ein Verweis auf eine Typseite.",
          "oneOf": [
            { "$ref": "#/$defs/kebab" },
            { "$ref": "#/$defs/wikilink" }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/wert"
      }
    },
    "hkb": {
      "description": "Anhang A.1 — Wurzeldatei einer Wissensbasis. Traegt kein type.",
      "type": "object",
      "required": [
        "hkf",
        "name"
      ],
      "propertyNames": {
        "$ref": "#/$defs/property-name"
      },
      "properties": {
        "config_base": {
          "type": "string"
        },
        "hkf": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "media_base": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_base": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/hkf-link-or-url"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "wiki_base": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/wert"
      }
    },
    "hbundle": {
      "description": "4.1 — id und description sind die beiden einzigen Pflichten.",
      "type": "object",
      "required": [
        "type",
        "id",
        "description"
      ],
      "propertyNames": {
        "$ref": "#/$defs/property-name"
      },
      "properties": {
        "type": {
          "const": "bundle"
        },
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "required_bundles": {
          "$ref": "#/$defs/flache-liste"
        },
        "hkf": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "base": {
          "type": "string"
        },
        "media_base": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "$ref": "#/$defs/hkf-link-or-url"
        },
        "imported": {
          "$ref": "#/$defs/datetime"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/wert"
      }
    }
  }
}
