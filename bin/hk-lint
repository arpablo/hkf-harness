#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""hk-lint — prueft eine Wissensbasis gegen HKF Core (§6.3).

    hk-lint [pfad] [--fix] [--strict]

Ohne Pfad gilt $HKB_PATH, sonst ~/hkb. Geprueft wird eine Wissensbasis
(`hkb.md`) oder eine Lieferung (`hbundle.md`) — §6.3 gilt fuer beide, mit
den Unterschieden, die §4 und §7.1 machen: Ein Bundle hat keine
Typverzeichnisse, seine Notizen liegen, wo sie wollen, und `bundles` und
`rejected_links` stehen dort nicht.

    --fix      die elf Handgriffe aus §6.3 ausfuehren und danach erneut pruefen
    --strict   zusaetzlich undeklarierte Properties melden, je Typ zusammengefasst

Gemeldet wird in drei Gruppen: das Frontmatter gegen das Schema aus Anhang
B.4, die Grammatik der Wikilinks und Typangaben aus Anhang B, und was sich
erst aus dem Zusammenhang ergibt — Typ gegen Verzeichnis, Verweise, die
abgeleiteten Tabellen, `# Siehe auch`, die Nachweise der Bundle-Notizen.

`fehler` heisst: Die Ablage ist nicht konform (§7.2). `hinweis` heisst: Es
faellt auf, macht sie aber nicht ungueltig.
"""
import os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from hkf import (CORE, ablage, fassung, frontmatter, grammatik,   # noqa: E402
                 korrigieren, pruefen as pruefmodul, schema)

FEHLT = """Alle Pruefungen aus §6.3 sind umgesetzt."""


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip()); print(); print(FEHLT); return 0
    strict = "--strict" in argv
    fix = "--fix" in argv
    args = [a for a in argv if not a.startswith("-")]
    try:
        hkb, art = ablage.finde_ablage(args[0] if args else None)
    except ablage.KeineAblage as e:
        sys.stderr.write(str(e) + "\n"); return 2

    print("%s — %s%s" % (hkb, "Wissensbasis" if art == "hkb" else "Lieferung",
                         ", mit --fix" if fix else ""))
    if fix and art != "hkb":
        sys.stderr.write("--fix gilt nur für eine Wissensbasis; eine Lieferung "
                         "wird gelesen, nicht geändert (§6.2).\n")
        return 2
    if fix:
        getan = korrigieren.korrigieren(hkb)
        print()
        print("Korrigiert" if getan else "Nichts zu korrigieren")
        for g in getan:
            print("  ·", g)
        print()

    wurzel = schema.laden()
    fm_befunde, gr_befunde = [], []
    try:
        ihre = frontmatter.lesen(os.path.join(
            hkb, "hkb.md" if art == "hkb" else "hbundle.md"))[0].get("hkf")
    except frontmatter.Unlesbar:
        ihre = None            # gemeldet wird das unten, einmal (Anhang B.4)
    if ihre is not None and not fassung.lesbar(ihre):
        fm_befunde.append("hkb.md: %s. Der Harness prüft gegen Regeln, die "
                          "diese Ablage nicht meint." % fassung.satz(ihre))
    geprueft = 0
    for p in ablage.dateien(hkb):
        rel = os.path.relpath(p, hkb)
        try:
            daten, _ = frontmatter.lesen(p)
        except frontmatter.Unlesbar as e:
            fm_befunde.append("%s: Frontmatter ist kein YAML — %s" % (rel, e.grund))
            continue
        except Exception as e:
            fm_befunde.append("%s: %s" % (rel, e))
            continue
        if not daten:
            continue                      # keine Notiz, keine Wurzeldatei
        form = schema.einstieg(p)
        if form == "notiz" and "type" not in daten:
            continue                      # §4.3: ohne `type` keine Notiz
        geprueft += 1
        for b in schema.pruefen(daten, wurzel["$defs"][form], wurzel):
            fm_befunde.append("%s: %s" % (rel, b))
        grammatik.pruefe_datei(p, gr_befunde, name=rel)

    bestand, struktur = pruefmodul.pruefen(hkb, art)
    fehler = [b for b in struktur if b.grad == pruefmodul.FEHLER]
    hinweise = [b for b in struktur if b.grad == pruefmodul.HINWEIS]

    print("%d Dateien geprüft" % geprueft)
    for titel, befunde in (("Frontmatter (Anhang B.4)", fm_befunde),
                           ("Grammatik (Anhang B)", gr_befunde),
                           ("Struktur (§6.3)", [str(b) for b in fehler])):
        print("  %-26s %d Befunde" % (titel, len(befunde)))
        for b in befunde:
            print("    -", b)
    print("  %-26s %d" % ("Hinweise", len(hinweise)))
    for b in hinweise:
        print("    ·", b)

    if strict:
        zeilen = pruefmodul.undeklariert(bestand)
        print("  %-26s %d" % ("Undeklarierte Properties", len(zeilen)))
        for z in zeilen:
            print("    ·", z)

    return 1 if fm_befunde or gr_befunde or fehler else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
