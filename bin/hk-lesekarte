#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""hk-lesekarte — den Stand der Entitaeten einer grossen Quelle fuehren.

    hk-lesekarte <quellennotiz>                       zeigt die Karte
    hk-lesekarte <quellennotiz> --anlegen <datei|->   legt sie aus Wilmas Kandidaten an
    hk-lesekarte <quellennotiz> --offen               was noch aussteht
    hk-lesekarte <quellennotiz> --nachtragen <zeile>  einen Eintrag ergaenzen
    hk-lesekarte <quellennotiz> --setzen <id>         eine Entscheidung festschreiben

    --behandlung B  create_or_extend, link_if_exists oder context_only
    --zustand Z     offen, angelegt, ergaenzt, zurueckgestellt oder verworfen
    --notiz P       wohin der Eintrag geschrieben wurde
    --grund T       warum, in einem Halbsatz
    --force         eine vorhandene Karte ersetzen

`hk-tranchen` sagt, welches Kapitel dran ist. Diese Karte sagt, welcher
Gegenstand schon behandelt ist. Das ist nicht dasselbe: Eine Person kommt in
vier Tranchen vor, und ohne einen Stand je Gegenstand entscheidet jede Tranche
neu, ob sie eine Notiz bekommt.

**Die Karte ist Prozesszustand und kein Inhalt.** Sie liegt darum nicht in der
Quellennotiz, sondern unter `<inbox_base>/AgentDashboard/`. Dieser Bereich ist
der einzige, den Core ausdruecklich von der Pruefung ausnimmt: „Unsortiertes,
von HKF nicht geprueft" (§3.2.6). Genau dorthin gehoert ein Arbeitszettel, den
niemand liest und der keine Aussage ueber den Gegenstand macht.

Was gelesen wurde und wann, steht weiter im Abschnitt `# Tranchen` der
Quellennotiz — das ist eine Auskunft ueber die Quelle und gehoert einem Leser.
Welche Entitaet noch offen ist, gehoert dem Lauf.

Der Name des Bereichs kommt aus der Wurzeldatei und steht hier nicht fest. Eine
Lieferung hat keine Bereiche (§4), dort gilt die Vorgabe `00-Inbox`.

`--anlegen` liest Wilmas Abschnitt `## Notiz-Kandidaten`, Zeile fuer Zeile:

    - Lord Fisher — traegt die Reformlinie des Werks — genannt als: Fisher, Admiral Fisher

Ein fuehrendes `- `, `* ` oder `1. ` faellt weg, eine eingerueckte Folgezeile
(`Ist:`, `Haengt zusammen mit:`, `Behauptet:`) ebenso: Sie gehoert zum
Destillat und nicht auf die Karte. Die Behandlung steht danach auf `offen` und
wird mit `--setzen` vergeben. Wer sie schon kennt, schreibt sie als eigenes
Feld in die Zeile.
"""
import io, os, re, sys, unicodedata

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import yaml                                                    # noqa: E402
from hkf import ablage, frontmatter                            # noqa: E402
from hkf.quelle import Fehler, quellennotiz                    # noqa: E402

FORMAT = "hkf-lesekarte"
FASSUNG = 1
DASHBOARD = "AgentDashboard"

BEHANDLUNGEN = ("offen", "create_or_extend", "link_if_exists", "context_only")
ZUSTAENDE = ("offen", "angelegt", "ergaenzt", "zurueckgestellt", "verworfen")
# Was eine Notiz hinterlaesst, setzt `create_or_extend` voraus. Ein
# `context_only`, das angeblich eine Notiz angelegt hat, ist ein Widerspruch
# und keine Nachlaessigkeit: Eine der beiden Angaben ist falsch.
SCHREIBT = ("angelegt", "ergaenzt")

VORSATZ = re.compile(r"^(?:[-*+]\s+|\d+[.)]\s+)")
TRENNER = re.compile(r"\s+[—–-]\s+")
GENANNT = re.compile(r"^genannt als:\s*", re.I)


# ── Der Ort ─────────────────────────────────────────────────────────────

def kartenpfad(quellpfad):
    """Wo die Karte zu dieser Quellennotiz liegt."""
    wurzel = ablage.aufwaerts(os.path.dirname(os.path.abspath(quellpfad)))
    if not wurzel:
        raise Fehler("%s liegt in keiner Ablage (§3.1)." % quellpfad)
    try:
        inbox = ablage.bereiche(wurzel)["inbox_base"]
    except Exception:
        inbox = ablage.VORGABEN["inbox_base"]      # eine Lieferung hat keine
    stamm = os.path.basename(quellpfad)[:-3]
    return os.path.join(wurzel, inbox or ablage.VORGABEN["inbox_base"],
                        DASHBOARD, "lesekarte-%s.yaml" % stamm)


def lesen(pfad):
    """Die Karte, oder None."""
    if not os.path.isfile(pfad):
        return None
    try:
        karte = yaml.safe_load(io.open(pfad, encoding="utf-8").read()) or {}
    except yaml.YAMLError as e:
        raise Fehler("%s ist kein YAML — %s" % (pfad, e))
    if karte.get("format") != FORMAT:
        raise Fehler("%s traegt `format: %s` und ist keine Lesekarte."
                     % (pfad, karte.get("format")))
    karte.setdefault("eintraege", [])
    return karte


def sichern(pfad, karte):
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    io.open(pfad, "w", encoding="utf-8").write(
        yaml.safe_dump(karte, allow_unicode=True, sort_keys=False,
                       default_flow_style=False))


# ── Die Eintraege ───────────────────────────────────────────────────────

def kennung(name, vergeben):
    """Ein Name wird eine ID: klein, ohne Zeichen, eindeutig.

    Die deutschen Umlaute werden ausgeschrieben, jedes andere Zeichen mit
    Diakritikum auf seinen Grundbuchstaben gebracht. Ohne den zweiten Schritt
    wurde aus `Café Groppi` ein `caf-groppi`, und eine Kennung, die einen
    Buchstaben verliert, findet spaeter niemand wieder.
    """
    roh = name.lower()
    for a, b in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
        roh = roh.replace(a, b)
    roh = "".join(c for c in unicodedata.normalize("NFD", roh)
                  if not unicodedata.combining(c))
    roh = re.sub(r"[^a-z0-9]+", "-", roh).strip("-") or "eintrag"
    id_, n = roh, 2
    while id_ in vergeben:
        id_, n = "%s-%d" % (roh, n), n + 1
    return id_


def zerlegen(zeile, vergeben):
    """Eine Kandidatenzeile wird ein Eintrag, oder None."""
    z = VORSATZ.sub("", zeile.strip()).strip()
    if not z:
        return None
    teile = [t.strip() for t in TRENNER.split(z) if t.strip()]
    if not teile:
        return None
    name, behandlung, grund, benennungen = teile[0], "offen", [], []
    for t in teile[1:]:
        if GENANNT.match(t):
            benennungen = [x.strip() for x in GENANNT.sub("", t).split(",")
                           if x.strip()]
        elif t in BEHANDLUNGEN:
            behandlung = t
        else:
            grund.append(t)
    return {"id": kennung(name, vergeben), "name": name,
            "benennungen": benennungen, "behandlung": behandlung,
            "zustand": "offen", "grund": " — ".join(grund), "notiz": ""}


def _finde(karte, id_):
    for e in karte["eintraege"]:
        if e.get("id") == id_:
            return e
    raise Fehler("Die Karte fuehrt keinen Eintrag `%s`. `hk-lesekarte "
                 "<quellennotiz>` zeigt, was sie fuehrt." % id_)


# ── Die Aufrufe ─────────────────────────────────────────────────────────

def _zeile(e):
    marke = "%s/%s" % (e.get("behandlung", "offen"), e.get("zustand", "offen"))
    aus = "  %-24s %-34s %s" % (e.get("id", ""), marke, e.get("name", ""))
    return aus.rstrip()


def zeigen(quellpfad, karte, pfad):
    if karte is None:
        print("%s traegt keine Lesekarte." % os.path.basename(quellpfad))
        print("  → hk-lesekarte %s --anlegen <datei|->" % quellpfad)
        return 0
    e = karte["eintraege"]
    offen = [x for x in e if _ist_offen(x)]
    print("%s — %d Eintraege, %d offen" % (os.path.basename(quellpfad),
                                           len(e), len(offen)))
    print("Karte: %s" % pfad)
    print()
    for x in e:
        print(_zeile(x))
    print()
    if offen:
        print("Offen: %s" % ", ".join(x["id"] for x in offen))
    else:
        print("Kein Eintrag steht mehr offen.")
    return 0


def _ist_offen(e):
    """Offen ist, was noch eine Entscheidung oder noch Arbeit braucht."""
    if e.get("behandlung", "offen") == "offen":
        return True
    return (e.get("behandlung") == "create_or_extend"
            and e.get("zustand", "offen") == "offen")


def offen(karte):
    if karte is None:
        raise Fehler("Diese Quellennotiz traegt keine Lesekarte.")
    aus = [e for e in karte["eintraege"] if _ist_offen(e)]
    if not aus:
        print("Kein Eintrag steht mehr offen.")
        return 1
    ohne = [e for e in aus if e.get("behandlung", "offen") == "offen"]
    print("%d von %d Eintraegen offen" % (len(aus), len(karte["eintraege"])))
    if ohne:
        print("Davon ohne Behandlung: %d" % len(ohne))
    print()
    for e in aus:
        print(_zeile(e))
        if e.get("grund"):
            print("  %-24s %s" % ("", e["grund"]))
    return 0


def anlegen(quellpfad, pfad, karte, herkunft, force):
    if karte is not None and not force:
        raise Fehler("Zu dieser Quelle liegt schon eine Karte mit %d "
                     "Eintraegen. --force ersetzt sie."
                     % len(karte["eintraege"]))
    text = sys.stdin.read() if herkunft == "-" else \
        io.open(herkunft, encoding="utf-8").read()
    eintraege, vergeben = [], set()
    for z in text.splitlines():
        if not z.strip() or z.strip().startswith("#"):
            continue
        if z[:1] in (" ", "\t"):
            continue                   # Folgezeile des Destillats
        e = zerlegen(z, vergeben)
        if e:
            vergeben.add(e["id"])
            eintraege.append(e)
    if not eintraege:
        raise Fehler("%s: keinen Kandidaten gefunden."
                     % ("die Standardeingabe" if herkunft == "-" else herkunft))
    wurzel = os.path.dirname(os.path.dirname(os.path.dirname(pfad)))
    sichern(pfad, {"format": FORMAT, "version": FASSUNG,
                   "quelle": os.path.relpath(os.path.abspath(quellpfad),
                                             wurzel).replace(os.sep, "/"),
                   "eintraege": eintraege})
    print("%s — %d Eintraege angelegt." % (os.path.basename(quellpfad),
                                           len(eintraege)))
    for e in eintraege:
        print(_zeile(e))
    print()
    print("Alle stehen auf `offen`. Die Behandlung vergibst du mit --setzen.")
    return 0


def nachtragen(quellpfad, pfad, karte, zeile):
    if karte is None:
        raise Fehler("Diese Quellennotiz traegt keine Lesekarte.")
    if zeile is True:
        raise Fehler("--nachtragen verlangt eine Zeile.")
    vergeben = set(e.get("id") for e in karte["eintraege"])
    e = zerlegen(zeile, vergeben)
    if not e:
        raise Fehler("Aus dieser Zeile wird kein Eintrag.")
    e["nachgetragen"] = True
    karte["eintraege"].append(e)
    sichern(pfad, karte)
    print("Nachgetragen:")
    print(_zeile(e))
    print()
    print("Nachgetragen heisst: nicht aus dem Aufbau-Lauf. Wer die Karte "
          "spaeter liest, sieht, was der Plan hergab und was unterwegs kam.")
    return 0


def setzen(pfad, karte, id_, werte):
    if karte is None:
        raise Fehler("Diese Quellennotiz traegt keine Lesekarte.")
    if id_ is True:
        raise Fehler("--setzen verlangt die Kennung eines Eintrags.")
    e = _finde(karte, id_)
    behandlung = werte.get("behandlung")
    zustand = werte.get("zustand")
    for name, wert, erlaubt in (("--behandlung", behandlung, BEHANDLUNGEN),
                                ("--zustand", zustand, ZUSTAENDE)):
        if wert is not None and wert is not True and wert not in erlaubt:
            raise Fehler("%s kennt nur %s." % (name, ", ".join(erlaubt)))
        if wert is True:
            raise Fehler("%s verlangt einen Wert." % name)
    # Erst rechnen, dann pruefen, dann schreiben. Ein Eintrag, der die Pruefung
    # nicht besteht, darf auch nicht halb geaendert im Speicher stehen.
    kuenftig = dict(e)
    if behandlung:
        kuenftig["behandlung"] = behandlung
    if zustand:
        kuenftig["zustand"] = zustand
    for feld in ("notiz", "grund"):
        if isinstance(werte.get(feld), str):
            kuenftig[feld] = werte[feld]
    if (kuenftig.get("zustand") in SCHREIBT
            and kuenftig.get("behandlung") != "create_or_extend"):
        raise Fehler("`%s` mit `behandlung: %s`: Eine Notiz entsteht nur unter "
                     "`create_or_extend`. Setz erst die Behandlung."
                     % (kuenftig["zustand"], kuenftig.get("behandlung")))
    e.clear()
    e.update(kuenftig)
    sichern(pfad, karte)
    print(_zeile(e).strip())
    if e.get("notiz"):
        print("  %s" % e["notiz"])
    rest = [x for x in karte["eintraege"] if _ist_offen(x)]
    print()
    print("Noch offen: %d von %d." % (len(rest), len(karte["eintraege"])))
    return 0


def argumente(argv):
    werte, rest, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            name = a[2:].replace("-", "_")
            folgt = argv[i + 1] if i + 1 < len(argv) else None
            if folgt is not None and not folgt.startswith("--"):
                werte[name], i = folgt, i + 2
            else:
                werte[name], i = True, i + 1
        else:
            rest.append(a)
            i += 1
    return werte, rest


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print(__doc__.strip())
        return 0 if argv else 2
    werte, rest = argumente(argv)
    if not rest:
        sys.stderr.write("hk-lesekarte verlangt eine Quellennotiz.\n")
        return 2
    quellpfad = os.path.abspath(os.path.expanduser(rest[0]))
    try:
        kopf, _ = quellennotiz(quellpfad)
        if kopf is None:
            raise Fehler("%s: kein Frontmatter — das ist keine Notiz." % quellpfad)
        pfad = kartenpfad(quellpfad)
        karte = lesen(pfad)
        if werte.get("anlegen"):
            if werte["anlegen"] is True:
                raise Fehler("--anlegen verlangt eine Datei oder `-`.")
            return anlegen(quellpfad, pfad, karte, werte["anlegen"],
                           bool(werte.get("force")))
        if werte.get("nachtragen"):
            return nachtragen(quellpfad, pfad, karte, werte["nachtragen"])
        if werte.get("setzen"):
            return setzen(pfad, karte, werte["setzen"], werte)
        if werte.get("offen"):
            return offen(karte)
        return zeigen(quellpfad, karte, pfad)
    except (Fehler, ablage.KeineAblage, frontmatter.Unlesbar) as e:
        sys.stderr.write(str(e) + "\n")
        return 2
    except IOError as e:
        sys.stderr.write("%s\n" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
