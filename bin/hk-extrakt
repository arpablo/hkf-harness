#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""hk-extrakt — das Evidenzjournal einer Quelle fuehren.

    hk-extrakt <quellennotiz>                          zeigt den Stand
    hk-extrakt <quellennotiz> --plan <datei|->         legt den Plan an
    hk-extrakt <quellennotiz> --naechste               welche Strecke dran ist
    hk-extrakt <quellennotiz> --anfuegen <datei|-> --strecke <id>
    hk-extrakt <quellennotiz> --gelesen <id>           Strecke ohne Ertrag
    hk-extrakt <quellennotiz> --stand                  Abdeckung je These
    hk-extrakt <quellennotiz> --thesen                 die Thesen im Wortlaut
    hk-extrakt <quellennotiz> --these <id>             die Karten einer These
    hk-extrakt <quellennotiz> --grenzen                wo das Werk selbst duenn wird
    hk-extrakt <quellennotiz> --gegenstaende           wer eine Notiz bekommt
    hk-extrakt <quellennotiz> --gegenstand <name>      die Karten zu einem
    hk-extrakt <quellennotiz> --strecken               fuer hk-tranchen --anlegen

    --schwelle N   ab wie vielen Thesen ein Gegenstand eine Notiz bekommt (2)
    --gedeckt N    ab wie vielen Karten eine These als gedeckt gilt (3)
    --force        einen vorhandenen Plan ersetzen, mehr als neun Thesen

Die These kommt vor der Notiz. Ein Lauf, der liest, schreibt darum keine
Notiz, sondern Evidenzkarten mit festen Feldern in dieses Journal. Erst wenn
feststeht, was das Werk behauptet, entscheidet sich, was geschrieben wird.

**Das Format begrenzt, was eine Karte sein kann.** Behauptung und Mechanismus
je 400 Zeichen, ein Zitat 500, hoechstens acht Gegenstaende, kein unbekanntes
Feld. Das ist der Zweck und kein Schoenheitsfehler: Die Aufblaehung entsteht
dort, wo ein lesender Lauf frei formulieren darf.

Eine Karte gehoert immer zu einer These aus dem Plan. Findet ein Lauf etwas
Tragendes ohne These, ist das ein Befund und keine Karte: Dann fehlt dem Plan
eine These, und darueber entscheidet nicht der Lesezug.

Der Plan ist YAML:

    werkfrage: Warum zerfiel die osmanische Ordnung nicht in eine neue?
    thesen:
      - id: t1
        behauptung: Die Aufteilung folgte britischen Ressortinteressen.
        mechanismus: Konkurrierende Behoerden gaben widerspruechliche Zusagen.
    strecken:
      - id: s1
        abschnitt: Teil I, Kap. 1-6
        thesen: [t1]

Das Journal ist JSONL, eine Karte je Zeile:

    {"these": "t1", "art": "beleg", "behauptung": "…",
     "mechanismus": "…", "lokator": "S. 214", "zitat": "…",
     "gegenstaende": ["Kitchener", "Arab Bureau"]}

`art` ist `beleg`, `gegenbeleg`, `definition` oder `grenze`. Eine `grenze`
haelt fest, wo der Autor selbst offenlaesst oder einschraenkt. Ohne diese Art
laesst sich der vierte Teil des Kopfes nicht schreiben, und die Quellennotiz
taeuscht dann eine Geschlossenheit vor, die das Werk nicht hat.

`--strecke` traegt die Karten ein, `strecke` steht darum nicht in der Zeile.
Eine einzige fehlerhafte Zeile weist den ganzen Stapel ab. Ein halb
geschriebenes Journal waere schlimmer als ein wiederholter Aufruf.
"""
import io, json, os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import yaml                                                    # noqa: E402
from hkf import ablage, frontmatter                            # noqa: E402
from hkf.quelle import Fehler, arbeitszettel, quellennotiz     # noqa: E402

PLAN_FORMAT = "hkf-quellplan"
FASSUNG = 1

# Wie viele Thesen ein Werk hat. Wer zwanzig Hauptthesen findet, hat keine
# gefunden, sondern das Inhaltsverzeichnis abgeschrieben.
THESEN_MAX = 9
# Ab wann eine These als gedeckt gilt und keine Nachforderung mehr ausloest.
GEDECKT = 3
# Ab wie vielen Thesen ein Gegenstand die Schwelle nimmt.
SCHWELLE = 2
# Wann das Journal selbst zum Problem wird. Der Entwurf setzt hier den
# Abbruch: Ein Journal, das mitwaechst statt zu verdichten, hat den Fehler
# nur verschoben.
JOURNAL_WARNUNG = 300_000

ARTEN = ("beleg", "gegenbeleg", "definition", "grenze")
PFLICHT = ("these", "behauptung", "lokator")
GRENZEN = {"behauptung": 400, "mechanismus": 400, "zitat": 500,
           "lokator": 60, "these": 16, "art": 16}
FELDER = tuple(GRENZEN) + ("gegenstaende",)
GEGENSTAENDE_MAX = 8
NAME_MAX = 80


# ── Die Orte ────────────────────────────────────────────────────────────

def planpfad(quellpfad):
    return arbeitszettel(quellpfad, "plan-%s.yaml")


def journalpfad(quellpfad):
    return arbeitszettel(quellpfad, "extrakt-%s.jsonl")


def plan_lesen(pfad):
    """Der Plan, oder None."""
    if not os.path.isfile(pfad):
        return None
    try:
        plan = yaml.safe_load(io.open(pfad, encoding="utf-8").read()) or {}
    except yaml.YAMLError as e:
        raise Fehler("%s ist kein YAML — %s" % (pfad, e))
    if plan.get("format") != PLAN_FORMAT:
        raise Fehler("%s traegt `format: %s` und ist kein Quellplan."
                     % (pfad, plan.get("format")))
    return plan


def journal_lesen(pfad):
    """Die Karten, in der Reihenfolge, in der sie kamen."""
    if not os.path.isfile(pfad):
        return []
    karten = []
    for nr, zeile in enumerate(io.open(pfad, encoding="utf-8"), 1):
        if not zeile.strip():
            continue
        try:
            karten.append(json.loads(zeile))
        except ValueError as e:
            raise Fehler("%s Zeile %d ist kein JSON — %s" % (pfad, nr, e))
    return karten


# ── Der Plan ────────────────────────────────────────────────────────────

def plan_pruefen(roh, force):
    """Aus der Eingabe wird ein Plan, oder es wird ein Fehler."""
    if not isinstance(roh, dict):
        raise Fehler("Der Plan ist kein YAML-Mapping.")
    werkfrage = str(roh.get("werkfrage") or "").strip()
    if not werkfrage:
        raise Fehler("Dem Plan fehlt die `werkfrage`. Sie ist der Grund, aus "
                     "dem spaeter ueberhaupt gelesen wird.")
    thesen = roh.get("thesen") or []
    if not isinstance(thesen, list) or not thesen:
        raise Fehler("Dem Plan fehlen `thesen`.")
    if len(thesen) > THESEN_MAX and not force:
        raise Fehler("%d Thesen. Ein Werk traegt selten mehr als %d, und wer "
                     "mehr findet, hat meist das Inhaltsverzeichnis "
                     "abgeschrieben. --force nimmt sie trotzdem."
                     % (len(thesen), THESEN_MAX))
    sauber, kennungen = [], set()
    for i, t in enumerate(thesen, 1):
        if not isinstance(t, dict):
            raise Fehler("These %d ist kein Mapping." % i)
        id_ = str(t.get("id") or "").strip()
        behauptung = str(t.get("behauptung") or "").strip()
        if not id_:
            raise Fehler("These %d hat keine `id`." % i)
        if id_ in kennungen:
            raise Fehler("Die Thesenkennung `%s` kommt zweimal vor." % id_)
        if not behauptung:
            raise Fehler("These `%s` hat keine `behauptung`. Ein Thema ist "
                         "keine These: Es fehlt der Satz, fuer den der Autor "
                         "einsteht." % id_)
        kennungen.add(id_)
        sauber.append({"id": id_, "behauptung": behauptung,
                       "mechanismus": str(t.get("mechanismus") or "").strip(),
                       "abschnitte": [str(a) for a in (t.get("abschnitte") or [])]})
    strecken, gesehen = [], set()
    for i, s in enumerate(roh.get("strecken") or [], 1):
        if not isinstance(s, dict):
            raise Fehler("Strecke %d ist kein Mapping." % i)
        id_ = str(s.get("id") or "").strip()
        if not id_:
            raise Fehler("Strecke %d hat keine `id`." % i)
        if id_ in gesehen:
            raise Fehler("Die Streckenkennung `%s` kommt zweimal vor." % id_)
        gesehen.add(id_)
        ihre = [str(x) for x in (s.get("thesen") or [])]
        unbekannt = [x for x in ihre if x not in kennungen]
        if unbekannt:
            raise Fehler("Strecke `%s` nennt die These %s, die der Plan nicht "
                         "fuehrt." % (id_, ", ".join("`%s`" % x for x in unbekannt)))
        strecken.append({"id": id_, "abschnitt": str(s.get("abschnitt") or ""),
                         "thesen": ihre, "zustand": "offen"})
    if not strecken:
        raise Fehler("Dem Plan fehlen `strecken`. Ohne sie weiss kein Lauf, "
                     "was als Naechstes gelesen wird.")
    return {"format": PLAN_FORMAT, "version": FASSUNG,
            "werkfrage": werkfrage, "thesen": sauber, "strecken": strecken}


def plan_anlegen(quellpfad, pfad, vorhanden, herkunft, force):
    if vorhanden is not None and not force:
        raise Fehler("Zu dieser Quelle liegt schon ein Plan mit %d Thesen. "
                     "--force ersetzt ihn, und das Journal bleibt dabei "
                     "liegen." % len(vorhanden.get("thesen") or []))
    text = sys.stdin.read() if herkunft == "-" else \
        io.open(herkunft, encoding="utf-8").read()
    try:
        roh = yaml.safe_load(text)
    except yaml.YAMLError as e:
        raise Fehler("Die Eingabe ist kein YAML — %s" % e)
    plan = plan_pruefen(roh, force)
    wurzel = os.path.dirname(os.path.dirname(os.path.dirname(pfad)))
    plan["quelle"] = os.path.relpath(os.path.abspath(quellpfad),
                                     wurzel).replace(os.sep, "/")
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    io.open(pfad, "w", encoding="utf-8").write(
        yaml.safe_dump(plan, allow_unicode=True, sort_keys=False,
                       default_flow_style=False))
    print("%s — %d Thesen, %d Strecken."
          % (os.path.basename(quellpfad), len(plan["thesen"]),
             len(plan["strecken"])))
    print("Werkfrage: %s" % plan["werkfrage"])
    print()
    for t in plan["thesen"]:
        print("  %-6s %s" % (t["id"], t["behauptung"]))
    print()
    print("Plan: %s" % pfad)
    return 0


def plan_sichern(pfad, plan):
    io.open(pfad, "w", encoding="utf-8").write(
        yaml.safe_dump(plan, allow_unicode=True, sort_keys=False,
                       default_flow_style=False))


# ── Die Karten ──────────────────────────────────────────────────────────

def karte_pruefen(roh, nr, thesen):
    """Eine Zeile wird eine Karte, oder es wird ein Fehler mit Zeilennummer."""
    wo = "Zeile %d" % nr
    if not isinstance(roh, dict):
        raise Fehler("%s ist kein JSON-Objekt." % wo)
    fremd = [k for k in roh if k not in FELDER]
    if fremd:
        raise Fehler("%s traegt das unbekannte Feld %s. Erlaubt sind %s. Was "
                     "in kein Feld passt, gehoert nicht auf eine Karte."
                     % (wo, ", ".join("`%s`" % f for f in sorted(fremd)),
                        ", ".join("`%s`" % f for f in FELDER)))
    for feld in PFLICHT:
        if not str(roh.get(feld) or "").strip():
            raise Fehler("%s fehlt `%s`." % (wo, feld))
    karte = {}
    for feld, grenze in GRENZEN.items():
        wert = str(roh.get(feld) or "").strip()
        if len(wert) > grenze:
            raise Fehler("%s: `%s` misst %d Zeichen, erlaubt sind %d. Kuerze "
                         "auf die Behauptung, oder mach zwei Karten daraus."
                         % (wo, feld, len(wert), grenze))
        if wert:
            karte[feld] = wert
    karte.setdefault("art", "beleg")
    if karte["art"] not in ARTEN:
        raise Fehler("%s: `art` ist `%s` und keines von %s."
                     % (wo, karte["art"], ", ".join(ARTEN)))
    if karte["these"] not in thesen:
        raise Fehler("%s nennt die These `%s`, die der Plan nicht fuehrt. Eine "
                     "Karte gehoert zu einer These. Traegt der Fund keine, ist "
                     "das ein Befund fuer den Bericht und keine Karte."
                     % (wo, karte["these"]))
    rohliste = roh.get("gegenstaende") or []
    if not isinstance(rohliste, list):
        raise Fehler("%s: `gegenstaende` ist keine Liste." % wo)
    if len(rohliste) > GEGENSTAENDE_MAX:
        raise Fehler("%s nennt %d Gegenstaende, erlaubt sind %d. Eine Karte "
                     "belegt eine Behauptung und ist kein Personenregister."
                     % (wo, len(rohliste), GEGENSTAENDE_MAX))
    namen = []
    for g in rohliste:
        name = str(g).strip()
        if not name:
            continue
        if len(name) > NAME_MAX:
            raise Fehler("%s: `%s…` ist kein Name, sondern ein Satz."
                         % (wo, name[:40]))
        if name not in namen:
            namen.append(name)
    if namen:
        karte["gegenstaende"] = namen
    return karte


def anfuegen(quellpfad, pfad, plan, planpf, herkunft, strecke, force):
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan. Ohne Thesen gibt es "
                     "keine Karten. → hk-extrakt %s --plan <datei|->"
                     % quellpfad)
    if strecke is None or strecke is True:
        raise Fehler("--anfuegen verlangt --strecke <id>. Die Karten erben "
                     "die Strecke, damit sie nicht in jeder Zeile steht.")
    treffer = [s for s in plan["strecken"] if s["id"] == strecke]
    if not treffer:
        raise Fehler("Der Plan fuehrt keine Strecke `%s`. Er fuehrt %s."
                     % (strecke, ", ".join(s["id"] for s in plan["strecken"])))
    s = treffer[0]
    if s["zustand"] == "gelesen" and not force:
        raise Fehler("Strecke `%s` gilt schon als gelesen. Was einmal "
                     "extrahiert ist, wird nicht noch einmal gelesen. --force "
                     "haengt trotzdem an." % strecke)
    text = sys.stdin.read() if herkunft == "-" else \
        io.open(herkunft, encoding="utf-8").read()
    thesen = set(t["id"] for t in plan["thesen"])
    neu = []
    for nr, zeile in enumerate(text.splitlines(), 1):
        z = zeile.strip()
        if not z or z.startswith("#"):
            continue
        try:
            roh = json.loads(z)
        except ValueError as e:
            raise Fehler("Zeile %d ist kein JSON — %s" % (nr, e))
        karte = karte_pruefen(roh, nr, thesen)
        karte["strecke"] = strecke
        neu.append(karte)
    # Erst alles pruefen, dann alles schreiben. Ein Stapel, der zur Haelfte
    # im Journal steht, ist schlimmer als ein zweiter Aufruf.
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    with io.open(pfad, "a", encoding="utf-8") as f:
        for k in neu:
            f.write(json.dumps(k, ensure_ascii=False, sort_keys=True) + "\n")
    s["zustand"] = "gelesen"
    plan_sichern(planpf, plan)
    ges = journal_lesen(pfad)
    print("Strecke `%s`: %d Karten aufgenommen, %d im Journal."
          % (strecke, len(neu), len(ges)))
    for t in plan["thesen"]:
        n = sum(1 for k in neu if k["these"] == t["id"])
        if n:
            print("  %-6s %d" % (t["id"], n))
    print()
    _journalgroesse(pfad)
    return 0


def gelesen(plan, planpf, strecke):
    """Eine Strecke ohne Ertrag abhaken."""
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    if strecke is True:
        raise Fehler("--gelesen verlangt die Kennung einer Strecke.")
    treffer = [s for s in plan["strecken"] if s["id"] == strecke]
    if not treffer:
        raise Fehler("Der Plan fuehrt keine Strecke `%s`." % strecke)
    treffer[0]["zustand"] = "gelesen"
    plan_sichern(planpf, plan)
    offen = [s for s in plan["strecken"] if s["zustand"] == "offen"]
    print("Strecke `%s` gilt als gelesen, ohne Ertrag." % strecke)
    print("Noch offen: %d von %d." % (len(offen), len(plan["strecken"])))
    return 0


# ── Der Stand ───────────────────────────────────────────────────────────

def _abdeckung(plan, karten, gedeckt):
    """Je These: Karten, gelesene Strecken, und wie es darum steht.

    **Die Zahl der Karten allein sagt nichts ueber die Deckung.** Die erste
    Strecke eines Buchs liefert zu fast jeder These ein paar Saetze, weil ein
    Autor seine Thesen in der Einleitung anreiszt. Wer daraus `gedeckt`
    schlieszt, hoert nach einem Zwoelftel des Werks auf. Genau das passierte
    beim ersten Lauf an Fromkin.

    Gedeckt ist eine These darum erst, wenn **jede Strecke gelesen ist, die
    der Plan ihr zugewiesen hat**, und dann noch genug Karten daliegen. Der
    Plan sagt, wo die These verhandelt wird, und das ist eine Aussage ueber
    das Werk. Die Kartenzahl ist nur ein Ertrag.
    """
    aus = []
    for t in plan["thesen"]:
        meine = [k for k in karten if k["these"] == t["id"]]
        gegen = sum(1 for k in meine if k.get("art") in ("gegenbeleg", "grenze"))
        ihre = [s for s in plan["strecken"] if t["id"] in s["thesen"]]
        fertig = [s for s in ihre if s["zustand"] == "gelesen"]
        if len(fertig) < len(ihre):
            zustand = "duenn" if meine else "offen"
        elif len(meine) < gedeckt:
            zustand = "duenn"
        else:
            zustand = "gedeckt"
        aus.append((t, len(meine), gegen, zustand, len(fertig), len(ihre)))
    return aus


def _journalgroesse(pfad):
    if not os.path.isfile(pfad):
        return
    n = os.path.getsize(pfad)
    if n > JOURNAL_WARNUNG:
        print("Das Journal misst %d Zeichen und ueberschreitet die Marke von "
              "%d. Es soll verdichten und nicht mitwachsen. Sieh nach, bevor "
              "weitergelesen wird." % (n, JOURNAL_WARNUNG))


def stand(quellpfad, plan, karten, pfad, gedeckt):
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    zeilen = _abdeckung(plan, karten, gedeckt)
    offen = [s for s in plan["strecken"] if s["zustand"] == "offen"]
    print("%s — %d Karten aus %d von %d Strecken."
          % (os.path.basename(quellpfad), len(karten),
             len(plan["strecken"]) - len(offen), len(plan["strecken"])))
    print("Werkfrage: %s" % plan["werkfrage"])
    print()
    for t, n, gegen, zustand, fertig, ihre in zeilen:
        marke = "%-8s %3d Karten %d/%d Strecken" % (zustand, n, fertig, ihre)
        if gegen:
            marke += " (%d dagegen)" % gegen
        print("  %-6s %-38s %s" % (t["id"], marke, t["behauptung"][:52]))
    print()
    fehlend = [t["id"] for t, n, _, z, _, _ in zeilen if z == "offen"]
    duenn = [t["id"] for t, n, _, z, _, _ in zeilen if z == "duenn"]
    if fehlend:
        print("Ohne Beleg: %s" % ", ".join(fehlend))
    if duenn:
        print("Duenn: %s" % ", ".join(duenn))
    if not fehlend and not duenn:
        print("Jede These ist gedeckt. Das Lesen kann enden.")
    _journalgroesse(pfad)
    return 0


def naechste(plan, karten, gedeckt):
    """Welche Strecke als Naechstes gelesen wird.

    Nicht das Inhaltsverzeichnis bestimmt die Reihenfolge, sondern die
    Werkfrage: Zuerst kommt die Strecke, die eine unbelegte These traegt.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    zustand = {t["id"]: z for t, _, _, z, _, _ in _abdeckung(plan, karten, gedeckt)}
    offen = [s for s in plan["strecken"] if s["zustand"] == "offen"]
    if not offen:
        print("Alle Strecken sind gelesen.")
        return 1
    for suche in ("offen", "duenn"):
        for s in offen:
            if any(zustand.get(x) == suche for x in s["thesen"]):
                grund = "traegt die %s These %s" % (
                    "unbelegte" if suche == "offen" else "duenn belegte",
                    ", ".join(x for x in s["thesen"]
                              if zustand.get(x) == suche))
                print("Strecke `%s` — %s" % (s["id"], s["abschnitt"]))
                print("  %s" % grund)
                print("  Thesen: %s" % ", ".join(s["thesen"]))
                return 0
    print("Keine offene Strecke traegt eine unbelegte These.")
    rest = sorted(i for i, z in zustand.items() if z != "gedeckt")
    if rest:
        print("Ungedeckt bleibt %s. Der Plan sieht dafuer keine Strecke mehr "
              "vor, und darueber entscheidet nicht der Lesezug: nachtragen "
              "oder als nicht deckbar berichten."
              % ", ".join("`%s`" % x for x in rest))
    print("%d Strecken bleiben ungelesen, und das ist kein Mangel: Gelesen "
          "wird, was die Werkfrage traegt." % len(offen))
    for s in offen:
        print("  %-6s %s" % (s["id"], s["abschnitt"]))
    return 1


def these(plan, karten, id_):
    """Die Karten einer These, fuer den schreibenden Lauf."""
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    if id_ is True:
        raise Fehler("--these verlangt eine Kennung.")
    treffer = [t for t in plan["thesen"] if t["id"] == id_]
    if not treffer:
        raise Fehler("Der Plan fuehrt keine These `%s`. Er fuehrt %s."
                     % (id_, ", ".join(t["id"] for t in plan["thesen"])))
    t = treffer[0]
    meine = [k for k in karten if k["these"] == id_]
    print("These %s: %s" % (t["id"], t["behauptung"]))
    if t.get("mechanismus"):
        print("Mechanismus laut Plan: %s" % t["mechanismus"])
    print("%d Karten." % len(meine))
    print()
    for k in meine:
        marke = "" if k.get("art") == "beleg" else " [%s]" % k.get("art")
        print("- %s%s (%s)" % (k["behauptung"], marke, k["lokator"]))
        if k.get("mechanismus"):
            print("  Mechanismus: %s" % k["mechanismus"])
        if k.get("zitat"):
            print("  Zitat: %s" % k["zitat"])
        if k.get("gegenstaende"):
            print("  Gegenstaende: %s" % ", ".join(k["gegenstaende"]))
    return 0 if meine else 1


def thesen(plan):
    """Die Thesen im Wortlaut, fuer den lesenden Lauf.

    `--stand` kuerzt auf eine Zeile und taugt zum Ueberblick. Wer damit
    lesen soll, bekaeme eine abgeschnittene Behauptung und keinen
    Mechanismus. Das ist genau das, woran ein Lesezug scheitert.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    print("Werkfrage: %s" % plan["werkfrage"])
    print()
    for t in plan["thesen"]:
        print("%s  %s" % (t["id"], t["behauptung"]))
        if t.get("mechanismus"):
            print("    Mechanismus: %s" % t["mechanismus"])
        print()
    return 0


def grenzen(plan, karten):
    """Wo das Werk selbst duenn wird.

    Der vierte Teil des Kopfes steht im Maszstab, und er hat keine eigene
    Quelle: Er besteht aus dem, was die Lesezuege als `grenze` und
    `gegenbeleg` angetragen haben. Ohne diesen Aufruf muesste der
    schreibende Lauf das ganze Journal sehen, um vier Zeilen zu finden.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    meine = [k for k in karten if k.get("art") in ("gegenbeleg", "grenze")]
    titel = {t["id"]: t["behauptung"] for t in plan["thesen"]}
    print("%d Karten halten eine Grenze oder einen Gegenbeleg fest."
          % len(meine))
    print()
    for id_ in [t["id"] for t in plan["thesen"]]:
        seine = [k for k in meine if k["these"] == id_]
        if not seine:
            continue
        print("These %s: %s" % (id_, titel[id_]))
        for k in seine:
            print("- [%s] %s (%s)" % (k["art"], k["behauptung"], k["lokator"]))
        print()
    if not meine:
        print("Kein Lauf hat eine Grenze angetragen. Das ist selten wahr und "
              "meist ein Zeichen, dass die Lesezuege nur bestaetigt haben.")
        return 1
    return 0


def strecken(plan, karten):
    """Die Abgrenzungen fuer `hk-tranchen --anlegen -`.

    Der Plan liegt unter `AgentDashboard/` und reist nicht in der Lieferung
    mit. Ohne diesen Schritt weiss nach dem Import niemand mehr, welcher Teil
    des Werks gelesen wurde. Das ist eine Auskunft ueber die Quelle und
    gehoert einem Leser, nicht dem Lauf.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    for s in plan["strecken"]:
        print(s["abschnitt"] or s["id"])
    print("# Gelesen: %s" % (", ".join(
        "%d" % i for i, s in enumerate(plan["strecken"], 1)
        if s["zustand"] == "gelesen") or "keine"))
    for i, s in enumerate(plan["strecken"], 1):
        if s["zustand"] == "gelesen":
            n = sum(1 for k in karten if k.get("strecke") == s["id"])
            print("#   %d  %s  %d Karten" % (i, s["id"], n))
    return 0


def gegenstand(plan, karten, name):
    """Die Karten zu einem Gegenstand, ueber alle Thesen hinweg.

    Wer eine Notiz schreibt, braucht genau diese und nicht das Journal. Der
    Abgleich ist ohne Ruecksicht auf Grosz- und Kleinschreibung, weil ein
    Lesezug denselben Namen zweimal verschieden schreibt.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    if name is True:
        raise Fehler("--gegenstand verlangt einen Namen.")
    gesucht = name.strip().lower()
    meine = [k for k in karten
             if any(g.lower() == gesucht for g in k.get("gegenstaende") or [])]
    if not meine:
        gibt = sorted({g for k in karten for g in k.get("gegenstaende") or []})
        raise Fehler("Keine Karte nennt `%s`. Das Journal fuehrt %s."
                     % (name, ", ".join(gibt) or "keinen Gegenstand"))
    # Wie er im Journal steht, nicht wie er erfragt wurde.
    name = next(g for g in meine[0]["gegenstaende"] if g.lower() == gesucht)
    titel = {t["id"]: t["behauptung"] for t in plan["thesen"]}
    thesen = sorted({k["these"] for k in meine})
    print("%s — %d Karten aus %d Thesen." % (name, len(meine), len(thesen)))
    print()
    for id_ in [t["id"] for t in plan["thesen"] if t["id"] in thesen]:
        print("These %s: %s" % (id_, titel[id_]))
        for k in [x for x in meine if x["these"] == id_]:
            marke = "" if k.get("art") == "beleg" else " [%s]" % k.get("art")
            print("- %s%s (%s)" % (k["behauptung"], marke, k["lokator"]))
            if k.get("mechanismus"):
                print("  Mechanismus: %s" % k["mechanismus"])
            if k.get("zitat"):
                print("  Zitat: %s" % k["zitat"])
        print()
    print("Diese Notiz traegt, was hier steht, und nichts weiter.")
    return 0


def gegenstaende(plan, karten, schwelle):
    """Wer eine Notiz bekommt, und wer eine Erwaehnung bleibt.

    Die Schwelle ist ein Naeherungsmass fuer „gilt ueber dieses eine Werk
    hinaus". Wer nur an einer einzigen These haengt, uebt in diesem Werk eine
    Funktion aus und traegt keine Erklaerung. Genau ist das nicht, aber es ist
    entscheidbar, und es nimmt dem Lauf den groessten Kostenposten aus der
    Hand: Ohne diese Regel legt jeder Lesezug an, was er sieht.

    Die Ausgabe frisst `hk-lesekarte --anlegen -`. Wer die Schwelle nicht
    nimmt, steht als Kommentarzeile darunter und faellt dort heraus.
    """
    if plan is None:
        raise Fehler("Zu dieser Quelle liegt kein Plan.")
    wo, lokatoren = {}, {}
    for k in karten:
        for name in k.get("gegenstaende") or []:
            wo.setdefault(name, set()).add(k["these"])
            lokatoren.setdefault(name, []).append(k["lokator"])
    # In einer Thesenbehauptung genannt zu werden zaehlt fuer sich. Wer im
    # Satz steht, fuer den der Autor einsteht, traegt die Erklaerung, auch
    # wenn er nur an dieser einen These haengt.
    genannt = set()
    for name in wo:
        for t in plan["thesen"]:
            if name.lower() in t["behauptung"].lower():
                genannt.add(name)
                break
    drin, draussen = [], []
    for name in sorted(wo, key=lambda n: (-len(wo[n]), n.lower())):
        n = len(wo[name])
        thesen = ", ".join(sorted(wo[name]))
        if n >= schwelle or name in genannt:
            grund = "traegt %s" % thesen
            if name in genannt and n < schwelle:
                grund += ", in der Thesenbehauptung genannt"
            drin.append((name, grund, len(lokatoren[name])))
        else:
            draussen.append((name, thesen, len(lokatoren[name])))
    print("## Notiz-Kandidaten")
    for name, grund, n in drin:
        print("- %s — create_or_extend — %s — %d Fundstellen" % (name, grund, n))
    print()
    print("# Unter der Schwelle von %d Thesen, also Erwaehnung und keine "
          "Notiz:" % schwelle)
    for name, thesen, n in draussen:
        print("# %s — nur %s — %d Fundstellen" % (name, thesen, n))
    print()
    print("# %d von %d Gegenstaenden nehmen die Schwelle."
          % (len(drin), len(wo)))
    return 0


def zeigen(quellpfad, plan, karten, planpf, journalpf, gedeckt):
    if plan is None:
        print("%s traegt keinen Quellplan." % os.path.basename(quellpfad))
        print("  → hk-extrakt %s --plan <datei|->" % quellpfad)
        return 0
    stand(quellpfad, plan, karten, journalpf, gedeckt)
    print()
    print("Plan:    %s" % planpf)
    print("Journal: %s" % journalpf)
    return 0


# ── Die Aufrufe ─────────────────────────────────────────────────────────

def argumente(argv):
    werte, rest, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            name = a[2:].replace("-", "_")
            folgt = argv[i + 1] if i + 1 < len(argv) else None
            if folgt is not None and not folgt.startswith("--"):
                werte[name], i = folgt, i + 2
            else:
                werte[name], i = True, i + 1
        else:
            rest.append(a)
            i += 1
    return werte, rest


def _zahl(werte, name, vorgabe):
    wert = werte.get(name)
    if wert is None or wert is True:
        return vorgabe
    try:
        return max(1, int(wert))
    except ValueError:
        raise Fehler("--%s verlangt eine Zahl." % name)


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print(__doc__.strip())
        return 0 if argv else 2
    werte, rest = argumente(argv)
    if not rest:
        sys.stderr.write("hk-extrakt verlangt eine Quellennotiz.\n")
        return 2
    quellpfad = os.path.abspath(os.path.expanduser(rest[0]))
    try:
        kopf, _ = quellennotiz(quellpfad)
        if kopf is None:
            raise Fehler("%s: kein Frontmatter — das ist keine Notiz." % quellpfad)
        planpf, journalpf = planpfad(quellpfad), journalpfad(quellpfad)
        plan = plan_lesen(planpf)
        force = bool(werte.get("force"))
        gedeckt = _zahl(werte, "gedeckt", GEDECKT)
        if werte.get("plan"):
            if werte["plan"] is True:
                raise Fehler("--plan verlangt eine Datei oder `-`.")
            return plan_anlegen(quellpfad, planpf, plan, werte["plan"], force)
        karten = journal_lesen(journalpf)
        if werte.get("anfuegen"):
            if werte["anfuegen"] is True:
                raise Fehler("--anfuegen verlangt eine Datei oder `-`.")
            return anfuegen(quellpfad, journalpf, plan, planpf,
                            werte["anfuegen"], werte.get("strecke"), force)
        if werte.get("gelesen"):
            return gelesen(plan, planpf, werte["gelesen"])
        if werte.get("these"):
            return these(plan, karten, werte["these"])
        if werte.get("thesen"):
            return thesen(plan)
        if werte.get("strecken"):
            return strecken(plan, karten)
        if werte.get("grenzen"):
            return grenzen(plan, karten)
        if werte.get("gegenstand"):
            return gegenstand(plan, karten, werte["gegenstand"])
        if werte.get("gegenstaende"):
            return gegenstaende(plan, karten, _zahl(werte, "schwelle", SCHWELLE))
        if werte.get("naechste"):
            return naechste(plan, karten, gedeckt)
        if werte.get("stand"):
            return stand(quellpfad, plan, karten, journalpf, gedeckt)
        return zeigen(quellpfad, plan, karten, planpf, journalpf, gedeckt)
    except (Fehler, ablage.KeineAblage, frontmatter.Unlesbar) as e:
        sys.stderr.write(str(e) + "\n")
        return 2
    except IOError as e:
        sys.stderr.write("%s\n" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
